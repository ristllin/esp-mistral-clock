# Mistral clock: base configuration (ESP-IDF 5.5, ESP32-C6FH8)
# Flash: 8MB embedded (C6FH8), QIO 80MHz
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Partition table (custom, see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Console on the native USB-Serial/JTAG peripheral: keeps esptool auto-reset
# working over the single USB-C cable and needs no USB host or UART bridge.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y

# Misc system
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_DEFAULT_CPU_FREQ_160=y

# TLS certificate bundle for HTTPS (Open-Meteo)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# TLS buffers: asymmetric and sized for the weather fetches. The largest
# incoming record (the server certificate chain) is about 5 KB, so an 8 KB
# input buffer is enough and leaves contiguous heap for the RSA verify; the
# GET requests are tiny, so the output buffer stays at 2 KB. Total SSL buffer
# use is about 10 KB instead of the 33 KB default.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# SNTP sets the system time directly
CONFIG_LWIP_SNTP_SET_SYSTEM_TIME_US=y
# two NTP servers (time_mgr sets pool.ntp.org and time.google.com)
CONFIG_LWIP_SNTP_MAX_SERVERS=2
